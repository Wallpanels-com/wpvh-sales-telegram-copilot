{
  "name": "wpvh-sales-telegram-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "seed:sales": "tsx scripts/seed-sales.ts",
    "check:ghl": "tsx scripts/check-ghl-readonly.ts",
    "check:telegram": "tsx scripts/check-telegram.ts",
    "telegram:set-webhook": "tsx scripts/set-telegram-webhook.ts",
    "telegram:delete-webhook": "tsx scripts/delete-telegram-webhook.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "openai": "^7.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
