# Server
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=
LOG_LEVEL=info

# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DELIVERY_MODE=disabled
TELEGRAM_ALLOWED_USER_IDS=

# Admins receive all relevant events
ADMIN_TELEGRAM_USER_IDS=

# Sales mapping is used by scripts/seed-sales.ts
# Example:
# SALES_MAPPINGS_JSON=[{"name":"Mary Razumna","telegramUserId":"123456789","wpGhlUserId":"abc","vhGhlUserId":"def"}]
SALES_MAPPINGS_JSON=[]

# AI provider: openai, groq, or openai-compatible.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_BASE_URL=

# Backward-compatible OpenAI aliases (optional when AI_API_KEY/AI_MODEL are set)
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REPLY_MAX_CHARS=240
AI_VALIDATE_ON_STARTUP=false
AI_RATE_LIMIT_MAX_RETRIES=2
AI_RATE_LIMIT_BASE_MS=1000

# HighLevel WallPanels
GHL_WP_LOCATION_ID=
GHL_WP_TOKEN=

# HighLevel Verona Home
GHL_VH_LOCATION_ID=
GHL_VH_TOKEN=

# Work schedule
TIMEZONE=America/New_York
WORK_START=08:45
WORK_END=20:00
WORK_DAYS=1,2,3,4,5,6
DAILY_BRIEF_TIME=08:45

# HighLevel inbound webhook protection.
# Use the same value as ?secret=... in the workflow webhook URLs.
GHL_WEBHOOK_SHARED_SECRET=

# Optional polling fallback. Keeps the bot working even before GHL workflows/webhooks are configured.
# Keep false until AI_API_KEY is configured and production delivery is approved.
AUTOMATION_ENABLED=false
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=60
POLLING_CHANNELS=SMS,Email,WhatsApp,Instagram,Facebook,Call
POLLING_LOOKBACK_MINUTES=5
MAX_OPPORTUNITY_PAGES_PER_SALES=5

# HighLevel API settings
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=v3

# Optional direct contact URL template. Placeholders: {locationId}, {contactId}
GHL_CONTACT_URL_TEMPLATE=https://app.gohighlevel.com/v2/location/{locationId}/contacts/detail/{contactId}
